.DS_Store
Thumbs.db
*.log

# Build output — generated by `node build.js`, never hand-edited or committed.
/dist/

# Environment / secrets — real credentials must never be committed.
.env
.env.*
!.env.example

# OS / editor / cloud-sync artifacts
*.crswap
*.tmp
desktop.ini

# Local spreadsheets and other working files not meant for the deployed site
*.xlsx
*.xlsx.*
*.xls

# Editor bundle build tooling — dev-only, never deployed.
# poda-editor.bundle.js (the built output) IS committed, same as supabase.min.js.
/node_modules/

